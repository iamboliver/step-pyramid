<?xml version="1.0" encoding="UTF-8"?>
<!--
  This file deploys as part of the step-pyramid site, so it only lives at
  https://oliverbarwell.com/step-pyramid/sitemap.xml -- NOT at the zone root
  (https://oliverbarwell.com/sitemap.xml, which 404s: this repo doesn't own
  that path, the main site's own deployment does). That also means nothing
  discovers it automatically; submit the URL above directly in Google
  Search Console. See README.md's SEO section.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://oliverbarwell.com/step-pyramid</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
</urlset>
